            //     .wrap_target
    0x80a0, //  0: pull   block
    0x6002, //  1: out    pins, 2
    0x602e, //  2: out    x, 14
    0xa042, //  3: nop
    0x0044, //  4: jmp    x--, 4
    0x6002, //  5: out    pins, 2
    0x602e, //  6: out    x, 14
    0x0047, //  7: jmp    x--, 7
            //     .wrap
};

